{%- doc -%}
  Renders the values for one product option as swatches, buttons, or dropdown options.

  @param {product_option} option - The product option whose values are rendered.
  @param {string} picker_type - The picker markup to render: `swatch`, `button`, `dropdown`, or `swatch_dropdown`.
  @param {block} [block] - The variant-picker block, required for swatch settings.
  @param {boolean} [event_dates] - The option holds event dates: past dates are skipped, each
    chip shows the formatted date and seats left, sold-out dates read "Fully booked".
  @param {object} [section] - The current product section context, supplied implicitly when rendered from that section and used to namespace option inputs.

  @example
  {% render 'product-variant-options', option: option, block: block, picker_type: 'button' %}
{%- enddoc -%}
{%- liquid
  assign product_form_id = 'product-form-' | append: section.id
  assign now = 'now' | date: '%s' | plus: 0
-%}

{%- for value in option.values -%}
  {%- if event_dates -%}
    {%- capture value_ts -%}{% render 'event-date', value: value.name, start: value.variant.metafields.custom.event_start.value, output: 'timestamp' %}{%- endcapture -%}
    {%- assign value_ts = value_ts | strip | plus: 0 -%}
    {%- comment -%} Unparseable values stay visible (value_ts 0), only real past dates are skipped. {%- endcomment -%}
    {%- if value_ts > 0 and value_ts <= now -%}
      {%- continue -%}
    {%- endif -%}
  {%- endif -%}
  {%- liquid
    assign swatch_focal_point = null
    if value.swatch.image
      assign image_url = value.swatch.image | image_url: width: 50
      assign swatch_value = 'url(' | append: image_url | append: ')'
      assign swatch_focal_point = value.swatch.image.presentation.focal_point
    elsif value.swatch.color
      assign swatch_value = 'rgb(' | append: value.swatch.color.rgb | append: ')'
    else
      assign swatch_value = null
    endif

    assign option_disabled = true
    if value.available
      assign option_disabled = false
    endif
  -%}

  {%- capture input_id -%}
    {{ section.id }}-{{ option.position }}-{{ forloop.index0 -}}
  {%- endcapture -%}

  {%- capture input_name -%}
    {{ option.name }}-{{ option.position }}
  {%- endcapture -%}

  {%- capture input_dataset -%}
    data-product-url="{{ value.product_url }}"
    data-option-value-id="{{ value.id }}"
    data-option-name="{{ option.name | escape }}"
  {%- endcapture -%}

  {%- capture label_unavailable -%}
    <span class="visually-hidden label-unavailable">
      {{- 'products.product.variant_sold_out_or_unavailable' | t -}}
    </span>
  {%- endcapture -%}

  {% assign escaped_value = value | escape %}

  {%- if picker_type == 'swatch' -%}
    {%- capture help_text -%}
      <span class="visually-hidden">{{ escaped_value }}</span>
      {{ label_unavailable }}
    {%- endcapture -%}

    {%
      render 'swatch-input',
      id: input_id,
      name: input_name,
      value: escaped_value,
      swatch: value.swatch,
      product_form_id: product_form_id,
      checked: value.selected,
      visually_disabled: option_disabled,
      shape: block.settings.swatch_shape,
      help_text: help_text,
      additional_props: input_dataset
    %}
  {%- elsif picker_type == 'button' -%}
    <input
      type="radio"
      id="{{ input_id }}"
      name="{{ input_name | escape }}"
      value="{{ escaped_value }}"
      form="{{ product_form_id }}"
      {% if value.selected %}
        checked
      {% endif %}
      {% if option_disabled %}
        class="disabled"
        {% if event_dates %}
          disabled
        {% endif %}
      {% endif %}
      {{ input_dataset }}
    >
    <label for="{{ input_id }}">
      {%- if event_dates -%}
        {%- liquid
          assign seats_note = ''
          assign date_variant = value.variant
          if option_disabled
            assign seats_note = 'events.seats.full' | t
          elsif date_variant.inventory_management == 'shopify' and date_variant.inventory_policy != 'continue'
            if date_variant.inventory_quantity <= 3
              assign seats_note = 'events.seats.few' | t: count: date_variant.inventory_quantity
            else
              assign seats_note = 'events.seats.left' | t: count: date_variant.inventory_quantity
            endif
          endif
        -%}
        <span class="event-chip__date">{% render 'event-date', value: value.name, start: value.variant.metafields.custom.event_start.value, output: 'short' %}</span>
        {%- if seats_note != blank -%}
          <span class="event-chip__seats">{{ seats_note }}</span>
        {%- endif -%}
      {%- else -%}
        {{ value -}}
        {{ label_unavailable }}
      {%- endif -%}
    </label>
  {%- elsif picker_type == 'dropdown' or picker_type == 'swatch_dropdown' -%}
    <option
      id="{{ input_id }}"
      value="{{ escaped_value }}"
      {% if value.selected %}
        selected="selected"
      {% endif %}
      {% if swatch_value and picker_type == 'swatch_dropdown' %}
        data-option-swatch-value="{{ swatch_value }}"
        {% if swatch_focal_point %}
          data-option-swatch-focal-point="{{ swatch_focal_point }}"
        {% endif %}
      {% endif %}
      {{ input_dataset }}
    >
      {% if option_disabled -%}
        {{- 'products.product.value_unavailable' | t: option_value: value -}}
      {%- else -%}
        {{- value -}}
      {%- endif %}
    </option>
  {%- endif -%}
{%- endfor -%}
