{% doc %}
  Parses an event date and renders it for the current locale. Sources, most robust first:
  1. `start`: the variant metafield custom.event_start (date_time). Never translated; converted to
     Palestine wall time here (the shop's own time zone may differ, e.g. America/New_York);
  2. `value`: the "Date" option value ("YYYY-MM-DD HH:MM", Palestine time). Translation tools may
     rewrite it, so Arabic-Indic (٠-٩) and Persian (۰-۹) digits are normalised to Latin and "/"
     to "-" before parsing. Weekday and month names, the time pattern and "Palestine time" come from the
  `events.date.*` locale keys, so English and Arabic each read naturally (Latin digits in both).

  UTC offset: snippets/event-utc-offset (DECISIONS.md, M4). The value is parsed with that
  explicit offset, so the timestamp is correct whatever the shop's time zone setting is.

  A value that cannot be parsed renders as the raw text; in the theme editor it is also flagged
  in the browser console. Nothing is printed for `timestamp` / `iso` in that case.

  @param {string} value - The variant option value, e.g. "2026-11-07 18:00". Required.
  @param {string} [start] - The variant's custom.event_start metafield value; wins over `value`.
  @param {string} [output] - What to print:
    'time' (default): <time> with the full date, time and "Palestine time";
    'tile': date tile (day, month, weekday + time) inside a <time>, full text for screen readers;
    'text': full date and time as plain text (no time zone);
    'short': short date and time as plain text ("Sat 7 Nov · 6:00 PM");
    'timestamp': Unix seconds (empty when invalid);
    'iso': ISO 8601 with offset, e.g. 2026-11-07T18:00+02:00 (empty when invalid).

  @example
  {% capture ts %}{% render 'event-date', value: variant.option1, output: 'timestamp' %}{% endcapture %}
  {% render 'event-date', value: variant.option1, output: 'tile' %}
{% enddoc %}
{%- liquid
  assign raw = value | strip
  assign raw = raw | replace: '٠', '0' | replace: '١', '1' | replace: '٢', '2' | replace: '٣', '3' | replace: '٤', '4'
  assign raw = raw | replace: '٥', '5' | replace: '٦', '6' | replace: '٧', '7' | replace: '٨', '8' | replace: '٩', '9'
  assign raw = raw | replace: '۰', '0' | replace: '۱', '1' | replace: '۲', '2' | replace: '۳', '3' | replace: '۴', '4'
  assign raw = raw | replace: '۵', '5' | replace: '۶', '6' | replace: '۷', '7' | replace: '۸', '8' | replace: '۹', '9'
  assign raw = raw | replace: '/', '-' | replace: '：', ':' | replace: 'T', ' '

  # custom.event_start wins: convert the instant to Palestine wall time. Shift the timestamp by
  # (Palestine offset - shop offset) and format it in the shop's zone; try +02:00 first and
  # switch to +03:00 when that date is in summer time.
  if start != blank
    assign start_ts = start | date: '%s' | plus: 0
    if start_ts > 1000000000
      assign shop_zone = start | date: '%z'
      assign shop_seconds = shop_zone | slice: 1, 2 | plus: 0 | times: 3600
      assign shop_minutes = shop_zone | slice: 3, 2 | plus: 0 | times: 60
      assign shop_seconds = shop_seconds | plus: shop_minutes
      assign shop_sign = shop_zone | slice: 0
      if shop_sign == '-'
        assign shop_seconds = 0 | minus: shop_seconds
      endif
      assign wall_seconds = start_ts | plus: 7200 | minus: shop_seconds
      # The shop's own offset can differ at the shifted instant (its DST change): re-read it there.
      assign shop_zone_at_wall = wall_seconds | date: '%z'
      if shop_zone_at_wall != shop_zone
        assign wall_shop_seconds = shop_zone_at_wall | slice: 1, 2 | plus: 0 | times: 3600
        assign wall_shop_minutes = shop_zone_at_wall | slice: 3, 2 | plus: 0 | times: 60
        assign wall_shop_seconds = wall_shop_seconds | plus: wall_shop_minutes
        assign wall_shop_sign = shop_zone_at_wall | slice: 0
        if wall_shop_sign == '-'
          assign wall_shop_seconds = 0 | minus: wall_shop_seconds
        endif
        assign wall_seconds = start_ts | plus: 7200 | minus: wall_shop_seconds
      endif
      assign wall = wall_seconds | date: '%Y-%m-%d %H:%M'
      assign wall_year = wall | slice: 0, 4 | plus: 0
      assign wall_month = wall | slice: 5, 2 | plus: 0
      assign wall_day = wall | slice: 8, 2 | plus: 0
      capture wall_offset
        render 'event-utc-offset', year: wall_year, month: wall_month, day: wall_day
      endcapture
      assign wall_offset = wall_offset | strip
      if wall_offset == '+03:00'
        assign wall = wall_seconds | plus: 3600 | date: '%Y-%m-%d %H:%M'
      endif
      assign raw = wall
    endif
  endif

  assign valid = false
  if raw.size == 16
    assign c4 = raw | slice: 4
    assign c7 = raw | slice: 7
    assign c10 = raw | slice: 10
    assign c13 = raw | slice: 13
    if c4 == '-' and c7 == '-' and c10 == ' ' and c13 == ':'
      assign year = raw | slice: 0, 4 | plus: 0
      assign month = raw | slice: 5, 2 | plus: 0
      assign day = raw | slice: 8, 2 | plus: 0
      assign hour = raw | slice: 11, 2 | plus: 0
      assign minute_text = raw | slice: 14, 2
      assign minute = minute_text | plus: 0
      if year > 1999 and month >= 1 and month <= 12 and day >= 1 and day <= 31 and hour <= 23 and minute <= 59
        assign valid = true
      endif
    endif
  endif

  if valid
    capture offset
      render 'event-utc-offset', year: year, month: month, day: day
    endcapture
    assign offset = offset | strip
    assign date_part = raw | slice: 0, 10
    assign time_part = raw | slice: 11, 5
    assign iso = date_part | append: 'T' | append: time_part | append: offset
    assign timestamp = raw | append: ' ' | append: offset | date: '%s' | plus: 0
    if timestamp < 1000000000
      assign valid = false
    endif
  endif

  if valid
    assign weekday_index = date_part | date: '%w' | plus: 0
    assign weekday_names = 'events.date.weekdays' | t | split: '|'
    assign month_names = 'events.date.months' | t | split: '|'
    assign month_index = month | minus: 1
    assign weekday_name = weekday_names[weekday_index]
    assign month_name = month_names[month_index]

    assign hour12 = hour | modulo: 12
    if hour12 == 0
      assign hour12 = 12
    endif
    if hour < 12
      assign meridiem = 'events.date.am' | t
    else
      assign meridiem = 'events.date.pm' | t
    endif
    assign time_text = 'events.date.time' | t: hour: hour12, minute: minute_text, meridiem: meridiem
    assign full_text = 'events.date.full' | t: weekday: weekday_name, day: day, month: month_name, year: year, time: time_text
    assign short_text = 'events.date.short' | t: weekday: weekday_name, day: day, month: month_name, time: time_text
    assign timezone = 'events.date.timezone' | t
  endif

  if output == blank
    assign output = 'time'
  endif
-%}
{%- if valid -%}
  {%- case output -%}
    {%- when 'timestamp' -%}
      {{- timestamp -}}
    {%- when 'iso' -%}
      {{- iso -}}
    {%- when 'text' -%}
      {{- full_text -}}
    {%- when 'short' -%}
      {{- short_text -}}
    {%- when 'tile' -%}
      <time class="event-date-tile" datetime="{{ iso }}">
        <span class="event-date-tile__day" aria-hidden="true">{{ day }}</span>
        <span class="event-date-tile__month" aria-hidden="true">{{ month_name }}</span>
        <span class="event-date-tile__meta" aria-hidden="true">{{ weekday_name }} · {{ time_text }}</span>
        <span class="visually-hidden">{{ full_text }} {{ timezone }}</span>
      </time>
    {%- else -%}
      <time class="event-date" datetime="{{ iso }}">
        {{- full_text }} <span class="event-date__zone">{{ timezone }}</span>
      </time>
  {%- endcase -%}
{%- else -%}
  {%- unless output == 'timestamp' or output == 'iso' -%}
    <span class="event-date event-date--raw" dir="auto">{{ value | escape }}</span>
    {%- if request.design_mode -%}
      <script>
        console.warn({{ 'events.date.invalid_editor' | t: value: value | json }});
      </script>
    {%- endif -%}
  {%- endunless -%}
{%- endif -%}
