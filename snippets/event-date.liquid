{% doc %}
  Parses an event date option value ("YYYY-MM-DD HH:MM", Palestine time) and renders it for the
  current locale. Weekday and month names, the time pattern and "Palestine time" come from the
  `events.date.*` locale keys, so English and Arabic each read naturally (Latin digits in both).

  UTC offset rule (docs/DECISIONS.md, M4): summer time (+03:00) from the last Saturday of March
  to the day before the last Saturday of October, otherwise +02:00. The value is parsed with
  that explicit offset, so the timestamp is correct whatever the shop's timezone setting is.
  Palestine sometimes moves the change (e.g. around Ramadan); in those weeks the offset can be
  one hour off. Google Calendar links use ctz=Asia/Hebron and are always right.

  A value that cannot be parsed renders as the raw text; in the theme editor it is also flagged
  in the browser console. Nothing is printed for `timestamp` / `iso` in that case.

  @param {string} value - The variant option value, e.g. "2026-11-07 18:00". Required.
  @param {string} [output] - What to print:
    'time' (default): <time> with the full date, time and "Palestine time";
    'tile': date tile (day, month, weekday + time) inside a <time>, full text for screen readers;
    'text': full date and time as plain text (no time zone);
    'short': short date and time as plain text ("Sat 7 Nov · 6:00 PM");
    'timestamp': Unix seconds (empty when invalid);
    'iso': ISO 8601 with offset, e.g. 2026-11-07T18:00+02:00 (empty when invalid).

  @example
  {% capture ts %}{% render 'event-date', value: variant.option1, output: 'timestamp' %}{% endcapture %}
  {% render 'event-date', value: variant.option1, output: 'tile' %}
{% enddoc %}
{%- liquid
  assign raw = value | strip
  assign valid = false
  if raw.size == 16
    assign c4 = raw | slice: 4
    assign c7 = raw | slice: 7
    assign c10 = raw | slice: 10
    assign c13 = raw | slice: 13
    if c4 == '-' and c7 == '-' and c10 == ' ' and c13 == ':'
      assign year = raw | slice: 0, 4 | plus: 0
      assign month = raw | slice: 5, 2 | plus: 0
      assign day = raw | slice: 8, 2 | plus: 0
      assign hour = raw | slice: 11, 2 | plus: 0
      assign minute_text = raw | slice: 14, 2
      assign minute = minute_text | plus: 0
      if year > 1999 and month >= 1 and month <= 12 and day >= 1 and day <= 31 and hour <= 23 and minute <= 59
        assign valid = true
      endif
    endif
  endif

  if valid
    # Last Saturday of March / October of this year (weekday of the 31st, stepped back to Saturday).
    assign march_back = year | append: '-03-31' | date: '%w' | plus: 1 | modulo: 7
    assign march_saturday = 31 | minus: march_back
    assign october_back = year | append: '-10-31' | date: '%w' | plus: 1 | modulo: 7
    assign october_saturday = 31 | minus: october_back
    assign offset = '+02:00'
    if month > 3 and month < 10
      assign offset = '+03:00'
    elsif month == 3 and day >= march_saturday
      assign offset = '+03:00'
    elsif month == 10 and day < october_saturday
      assign offset = '+03:00'
    endif
    assign date_part = raw | slice: 0, 10
    assign time_part = raw | slice: 11, 5
    assign iso = date_part | append: 'T' | append: time_part | append: offset
    assign timestamp = raw | append: ' ' | append: offset | date: '%s' | plus: 0
    if timestamp < 1000000000
      assign valid = false
    endif
  endif

  if valid
    assign weekday_index = date_part | date: '%w' | plus: 0
    assign weekday_names = 'events.date.weekdays' | t | split: '|'
    assign month_names = 'events.date.months' | t | split: '|'
    assign month_index = month | minus: 1
    assign weekday_name = weekday_names[weekday_index]
    assign month_name = month_names[month_index]

    assign hour12 = hour | modulo: 12
    if hour12 == 0
      assign hour12 = 12
    endif
    if hour < 12
      assign meridiem = 'events.date.am' | t
    else
      assign meridiem = 'events.date.pm' | t
    endif
    assign time_text = 'events.date.time' | t: hour: hour12, minute: minute_text, meridiem: meridiem
    assign full_text = 'events.date.full' | t: weekday: weekday_name, day: day, month: month_name, year: year, time: time_text
    assign short_text = 'events.date.short' | t: weekday: weekday_name, day: day, month: month_name, time: time_text
    assign timezone = 'events.date.timezone' | t
  endif

  if output == blank
    assign output = 'time'
  endif
-%}
{%- if valid -%}
  {%- case output -%}
    {%- when 'timestamp' -%}
      {{- timestamp -}}
    {%- when 'iso' -%}
      {{- iso -}}
    {%- when 'text' -%}
      {{- full_text -}}
    {%- when 'short' -%}
      {{- short_text -}}
    {%- when 'tile' -%}
      <time class="event-date-tile" datetime="{{ iso }}">
        <span class="event-date-tile__day" aria-hidden="true">{{ day }}</span>
        <span class="event-date-tile__month" aria-hidden="true">{{ month_name }}</span>
        <span class="event-date-tile__meta" aria-hidden="true">{{ weekday_name }} · {{ time_text }}</span>
        <span class="visually-hidden">{{ full_text }} {{ timezone }}</span>
      </time>
    {%- else -%}
      <time class="event-date" datetime="{{ iso }}">
        {{- full_text }} <span class="event-date__zone">{{ timezone }}</span>
      </time>
  {%- endcase -%}
{%- else -%}
  {%- unless output == 'timestamp' or output == 'iso' -%}
    <span class="event-date event-date--raw">{{ raw | escape }}</span>
    {%- if request.design_mode -%}
      <script>
        console.warn({{ 'events.date.invalid_editor' | t: value: raw | json }});
      </script>
    {%- endif -%}
  {%- endunless -%}
{%- endif -%}
