{% doc %}
  Renders an inline variant picker for a product card.

  Used by card-product for quick add "standard" on multi-variant products, so
  shoppers can choose options and add to cart without leaving the collection.
  Controls reuse Dawn's .product-form__input pill/dropdown classes (styled by
  component-product-variant-picker.css). Option data comes from the product's
  real options_with_values and variants — no title-based detection — so
  non-clothing products (for example digital patterns with a "Format" option)
  are handled identically.

  @param {product} card_product - The product whose options and variants are rendered. Required.
  @param {string} section_id - The section ID used to namespace picker control IDs.
  @param {string} product_form_id - The ID of the add-to-cart form the picker keeps in sync.

  @example
  {% render 'card-variant-picker', card_product: product, section_id: section.id, product_form_id: product_form_id %}
{% enddoc %}
{%- liquid
  assign selected_variant = card_product.selected_or_first_available_variant

  assign picker_style = 'dropdown'
  if card_product.options_with_values.size == 1 and card_product.options_with_values[0].values.size <= 6
    assign picker_style = 'pills'
  endif
-%}
<card-variant-picker class="card-variant-picker" data-product-form="{{ product_form_id }}">
  {%- for option in card_product.options_with_values -%}
    {%- assign option_index = forloop.index0 -%}
    {%- assign selected_value = selected_variant.options[option_index] -%}
    {%- if picker_style == 'pills' -%}
      <fieldset class="js product-form__input product-form__input--pill card-variant-picker__group">
        <legend class="form__label">{{ option.name | escape }}</legend>
        {%- for value in option.values -%}
          {%- liquid
            # A value is unavailable when no available variant uses it at this option position.
            assign value_available = false
            for variant in card_product.variants
              if variant.available and variant.options[option_index] == value
                assign value_available = true
                break
              endif
            endfor
          -%}
          <input
            type="radio"
            id="CardVariant-{{ section_id }}-{{ card_product.id }}-{{ option.position }}-{{ forloop.index0 }}"
            name="card-variant-{{ section_id }}-{{ card_product.id }}-{{ option.position }}"
            value="{{ value | escape }}"
            data-option-position="{{ option.position }}"
            {% if value == selected_value %}
              checked
            {% endif %}
            {% unless value_available %}
              disabled
            {% endunless %}
          >
          <label
            for="CardVariant-{{ section_id }}-{{ card_product.id }}-{{ option.position }}-{{ forloop.index0 }}"
            {% unless value_available %}
              class="card-variant-picker__value--unavailable"
            {% endunless %}
          >
            {%- if value_available -%}
              {{- value -}}
            {%- else -%}
              <span aria-hidden="true">{{ value }}</span>
              <span class="visually-hidden">{{ 'products.card.option_unavailable' | t: value: value }}</span>
            {%- endif -%}
          </label>
        {%- endfor -%}
      </fieldset>
    {%- else -%}
      <div class="product-form__input product-form__input--dropdown card-variant-picker__group">
        <label class="form__label" for="CardVariant-{{ section_id }}-{{ card_product.id }}-{{ option.position }}">
          {{- option.name | escape -}}
        </label>
        <div class="select">
          <select
            id="CardVariant-{{ section_id }}-{{ card_product.id }}-{{ option.position }}"
            class="select__select"
            name="card-variant-{{ section_id }}-{{ card_product.id }}-{{ option.position }}"
            data-option-position="{{ option.position }}"
          >
            {%- for value in option.values -%}
              <option value="{{ value | escape }}" {% if value == selected_value %}selected{% endif %}>
                {{- value -}}
              </option>
            {%- endfor -%}
          </select>
          <span class="svg-wrapper">
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </span>
        </div>
      </div>
    {%- endif -%}
  {%- endfor -%}

  {% comment %}
    Real variant data for local option-to-variant matching. Prices are
    pre-formatted with Liquid's money filters so the card never does
    currency maths in JavaScript.
  {% endcomment %}
  <script type="application/json" data-variant-data>
    [
      {%- for variant in card_product.variants -%}
        {%- liquid
          if settings.currency_code_enabled
            assign variant_price = variant.price | money_with_currency
            assign variant_compare_at = variant.compare_at_price | money_with_currency
          else
            assign variant_price = variant.price | money
            assign variant_compare_at = variant.compare_at_price | money
          endif
        -%}
        {
          "id": {{ variant.id | json }},
          "options": {{ variant.options | json }},
          "available": {{ variant.available | json }},
          "price": {{ variant_price | json }},
          "compare_at_price": {% if variant.compare_at_price %}{{ variant_compare_at | json }}{% else %}null{% endif %},
          "requires_selling_plan": {{ variant.requires_selling_plan | json }}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  </script>

  <div class="card-variant-picker__unavailable" data-picker-unavailable hidden>
    <span class="card-variant-picker__unavailable-text">
      {{- 'products.product.unavailable' | t -}}
    </span>
    <a href="{{ card_product.url }}" class="link underlined-link">
      {{- 'products.product.view_full_details' | t -}}
    </a>
  </div>

  <p class="visually-hidden" role="status" data-picker-status></p>
</card-variant-picker>
