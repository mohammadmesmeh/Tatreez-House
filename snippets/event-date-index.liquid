{% doc %}
  Prints the zero-based position of an event product's date option, or -1 for other products.
  Nothing here depends on names that translation can change (the option name "Date" becomes
  "التاريخ" with Translate & Adapt):
  - the date option is found by position (theme setting "Date option position", default 1, or
    the first option when a product has fewer); if that option holds no date but another option
    does, that one is used;
  - a product with variants is an event when its type is listed in the theme setting "Event
    product types", or its first variant has custom.event_start, or an option's first value
    parses as a date. Products without variants (only "Default Title") are never events.

  @param {product} product - The product. Required.

  @example
  {% capture date_index %}{% render 'event-date-index', product: product %}{% endcapture %}
  {% assign date_index = date_index | strip | plus: 0 %}
{% enddoc %}
{%- liquid
  assign found = -1
  assign position = settings.event_date_option_position | default: 1
  if product.has_only_default_variant == false
    assign candidate = position | minus: 1
    if candidate >= product.options.size
      assign candidate = 0
    endif
    assign first_variant = product.variants.first

    assign typed_event = false
    assign product_type = product.type | downcase | strip
    assign event_types = settings.event_product_types | downcase | split: ','
    for event_type in event_types
      assign wanted_type = event_type | strip
      if wanted_type != blank and wanted_type == product_type
        assign typed_event = true
        break
      endif
    endfor
    if first_variant.metafields.custom.event_start != blank
      assign typed_event = true
    endif

    # Which option's first value is a date: the configured one first, then the others.
    assign date_option = -1
    capture probe
      render 'event-date', value: first_variant.options[candidate], output: 'timestamp'
    endcapture
    assign probe = probe | strip
    if probe != blank
      assign date_option = candidate
    else
      for option_value in first_variant.options
        if forloop.index0 != candidate
          capture probe
            render 'event-date', value: option_value, output: 'timestamp'
          endcapture
          assign probe = probe | strip
          if probe != blank
            assign date_option = forloop.index0
            break
          endif
        endif
      endfor
    endif

    if date_option >= 0
      assign found = date_option
    elsif typed_event
      assign found = candidate
    endif
  endif
-%}
{{- found -}}
