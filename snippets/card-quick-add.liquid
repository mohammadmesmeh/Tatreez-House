{% doc %}
  The product card's action row: always visible, one button, same size and position on every
  card (pinned to the bottom of the card by component-card-tatreez.css).
  - Sold out: a disabled "Sold out" button.
  - Several variants, quantity rules or volume pricing: "Choose options", which opens Dawn's
    quick-add modal (variant chips + Add to cart, focus trapped, Escape closes).
  - One variant: "Add to cart", added through Dawn's product-form (opens the cart drawer).
  Each button has a full and a short label; compact cards show the short one, the accessible
  name always uses the full label plus the product title.
  card-quick-add.js only announces adding / added / error in the live region.

  @param {product} card_product - The product. Required.
  @param {string} section_id - The section ID used to namespace IDs. Required.
  @param {string} product_form_id - The unique product form ID. Required.
  @param {boolean} [qty_rules] - Whether the variant has quantity rules (precomputed by card-product).

  @example
  {% render 'card-quick-add', card_product: product, section_id: section.id, product_form_id: product_form_id, qty_rules: false %}
{% enddoc %}
{%- liquid
  assign title_id = 'title-' | append: section_id | append: '-' | append: card_product.id
  assign label_id = product_form_id | append: '-label'
  assign needs_options = false
  if card_product.variants_count > 1 or qty_rules or card_product.quantity_price_breaks_configured?
    assign needs_options = true
  endif
-%}
<card-quick-add
  class="card-quick-add"
  data-adding="{{ 'products.card.adding' | t: product: card_product.title | escape }}"
  data-added="{{ 'products.card.added' | t: product: card_product.title | escape }}"
  data-error="{{ 'products.card.error' | t: product: card_product.title | escape }}"
>
  <div class="quick-add no-js-hidden">
    {%- if card_product.available == false -%}
      <button
        type="button"
        class="quick-add__submit button button--secondary button--full-width card-action"
        aria-labelledby="{{ label_id }} {{ title_id }}"
        disabled
      >
        <span class="card-action__label" id="{{ label_id }}">{{ 'products.product.sold_out' | t }}</span>
        <span class="card-action__label--short" aria-hidden="true">{{ 'products.product.sold_out' | t }}</span>
      </button>
    {%- elsif needs_options -%}
      <modal-opener data-modal="#QuickAdd-{{ card_product.id }}">
        <button
          id="{{ product_form_id }}-submit"
          type="button"
          name="add"
          class="quick-add__submit button button--secondary button--full-width card-action"
          aria-haspopup="dialog"
          aria-labelledby="{{ label_id }} {{ title_id }}"
          data-product-url="{{ card_product.url }}"
        >
          <span class="card-action__label" id="{{ label_id }}">{{ 'products.product.choose_options' | t }}</span>
          <span class="card-action__label--short" aria-hidden="true">{{ 'products.card.options_short' | t }}</span>
          {%- render 'loading-spinner' -%}
        </button>
      </modal-opener>
      <quick-add-modal id="QuickAdd-{{ card_product.id }}" class="quick-add-modal">
        <div
          role="dialog"
          aria-label="{{ 'products.product.choose_product_options' | t: product_name: card_product.title | escape }}"
          aria-modal="true"
          class="quick-add-modal__content global-settings-popup"
          tabindex="-1"
        >
          <button
            id="ModalClose-{{ card_product.id }}"
            type="button"
            class="quick-add-modal__toggle"
            aria-label="{{ 'accessibility.close' | t }}"
          >
            {{- 'icon-close.svg' | inline_asset_content -}}
          </button>
          <div id="QuickAddInfo-{{ card_product.id }}" class="quick-add-modal__content-info"></div>
        </div>
      </quick-add-modal>
    {%- else -%}
      <product-form data-section-id="{{ section_id }}">
        {%- form 'product',
          card_product,
          id: product_form_id,
          class: 'form',
          novalidate: 'novalidate',
          data-type: 'add-to-cart-form'
        -%}
          <input
            type="hidden"
            name="id"
            value="{{ card_product.selected_or_first_available_variant.id }}"
            class="product-variant-id"
          >
          <button
            id="{{ product_form_id }}-submit"
            type="submit"
            name="add"
            class="quick-add__submit button button--secondary button--full-width card-action"
            aria-haspopup="dialog"
            aria-labelledby="{{ label_id }} {{ title_id }}"
            aria-live="polite"
            data-sold-out-message="true"
          >
            <span class="card-action__label" id="{{ label_id }}">{{ 'products.product.add_to_cart' | t }}</span>
            <span class="card-action__label--short" aria-hidden="true">{{ 'products.card.add_short' | t }}</span>
            <span class="sold-out-message hidden">{{ 'products.product.sold_out' | t }}</span>
            {%- render 'loading-spinner' -%}
          </button>
        {%- endform -%}
      </product-form>
    {%- endif -%}
  </div>
  <p class="visually-hidden" role="status" data-card-quick-add-status></p>
</card-quick-add>
