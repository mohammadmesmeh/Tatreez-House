{% doc %}
  Optional light logo shown instead of the main logo while the header is transparent over the
  homepage hero slideshow (section-hero-slideshow.css). Without it, the main logo is rendered in
  ivory with a CSS filter. Hidden by default in component-header-tatreez.css (loaded on every
  page) and shown only while the header is transparent over a hero-slideshow, so only one of the
  two logos is ever displayed and screen readers never get the logo name twice. Loaded lazily
  outside the homepage, so a hidden copy costs no request there.

  @param {image} image - The header section's "Logo over hero" setting. Renders nothing if blank.

  @example
  {% render 'header-logo-over-hero', image: section.settings.logo_over_hero %}
{% enddoc %}
{%- if image != blank -%}
  {%- liquid
    assign over_hero_alt = image.alt | default: shop.name
    assign over_hero_height = settings.logo_width | divided_by: image.aspect_ratio
    assign over_hero_loading = 'lazy'
    if template.name == 'index'
      assign over_hero_loading = 'eager'
    endif
  -%}
  {{
    image
    | image_url: width: 600
    | image_tag:
      class: 'header__heading-logo header__heading-logo--over-hero',
      width: settings.logo_width,
      height: over_hero_height,
      alt: over_hero_alt,
      loading: over_hero_loading
  }}
{%- endif -%}
