/*
  fonts.css — self-hosted webfonts for the Tatreez House theme.

  Declared here:
    - "Nunito"             latin subset, variable weight 200–1000, normal (OFL 1.1)
    - "Playwrite NZ Basic" latin subset, variable weight 100–400,  normal (OFL 1.1)

  License texts: docs/fonts/licenses/. See docs/fonts/README.md.

  Each family is scoped with unicode-range so Latin text uses Nunito / Playwrite
  NZ Basic. The actual font stacks
  are applied through the Dawn font variables in layout/theme.liquid
  (--font-body-family, --font-heading-family).

  Keep the .css.liquid extension: Shopify only processes Liquid (asset_url)
  inside .liquid assets. Linked from layout/theme.liquid as 'fonts.css'.
*/

/* Nunito — Latin, variable weight 200–1000, normal */
@font-face {
  font-family: 'Nunito';
  font-style: normal;
  font-weight: 200 1000;
  font-display: swap;
  src: url('{{ "nunito-latin.woff2" | asset_url }}') format('woff2');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308,
    U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}

/* Playwrite NZ Basic — Latin, variable weight 100–400, normal */
@font-face {
  font-family: 'Playwrite NZ Basic';
  font-style: normal;
  font-weight: 100 400;
  font-display: swap;
  src: url('{{ "playwrite-nz-basic.woff2" | asset_url }}') format('woff2');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308,
    U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}
