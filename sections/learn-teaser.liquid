{%- liquid
  assign teaser_blog = section.settings.blog
  assign has_articles = false
  if teaser_blog != blank and teaser_blog.articles_count > 0
    assign has_articles = true
  endif

  assign eyebrow = section.settings.eyebrow
  if eyebrow == blank
    assign eyebrow = 'sections.learn_teaser.eyebrow' | t
  endif
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'sections.learn_teaser.heading' | t
  endif
-%}

{{ 'section-learn-teaser.css' | asset_url | stylesheet_tag }}

{%- if has_articles -%}
  {{ 'component-card.css' | asset_url | stylesheet_tag }}
  {{ 'component-article-card.css' | asset_url | stylesheet_tag }}

  <div class="learn-teaser color-{{ section.settings.color_scheme }} gradient{% if section.settings.linen_surface %} th-linen{% endif %}">
    <div class="page-width th-section">
      <header class="th-section__header learn-teaser__header">
        <div>
          <p class="th-eyebrow">{{ eyebrow | escape }}</p>
          <h2 class="th-section__title h0">{{ heading | escape }}</h2>
        </div>
        <a href="{{ teaser_blog.url }}" class="learn-teaser__all"><span class="th-stitch th-stitch--persistent">{{ 'sections.learn_teaser.cta' | t }}</span></a>
      </header>
      <ul class="learn-teaser__grid list-unstyled" role="list">
        {%- for article in teaser_blog.articles limit: 3 -%}
          <li class="learn-teaser__item">
            {% render 'article-card',
              article: article,
              blog: teaser_blog,
              media_aspect_ratio: 1.25,
              show_image: true,
              show_date: section.settings.show_date,
              show_excerpt: true
            %}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- elsif request.design_mode -%}
  {%- comment -%}Editor-only guidance; the storefront renders nothing until articles exist.{%- endcomment -%}
  <div class="page-width th-section--tight">
    <p class="learn-teaser__editor-note">{{ 'sections.learn_teaser.editor_empty' | t }}</p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.learn-teaser.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "t:sections.learn-teaser.settings.blog.label",
      "info": "t:sections.learn-teaser.settings.blog.info"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.editorial.settings.eyebrow.label",
      "info": "t:sections.editorial.settings.default_copy.info"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.editorial.settings.heading.label",
      "info": "t:sections.editorial.settings.default_copy.info"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "default": true,
      "label": "t:sections.learn-teaser.settings.show_date.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "t:sections.all.colors.label"
    },
    {
      "type": "checkbox",
      "id": "linen_surface",
      "default": false,
      "label": "t:sections.all.linen_surface.label",
      "info": "t:sections.all.linen_surface.info"
    }
  ],
  "presets": [
    {
      "name": "t:sections.learn-teaser.presets.name"
    }
  ]
}
{% endschema %}
