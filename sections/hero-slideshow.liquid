{{ 'section-hero-slideshow.css' | asset_url | stylesheet_tag }}
<script src="{{ 'hero-slideshow.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign slide_count = section.blocks.size
  assign duration = section.settings.duration | default: 6
-%}

<div
  class="hero-slideshow hero-slideshow--{{ section.settings.height }} color-{{ section.settings.color_scheme }}"
  role="region"
  aria-roledescription="{{ 'sections.announcements.carousel' | t }}"
  aria-label="{{ 'sections.hero_slideshow.label' | t }}"
  style="--hero-duration: {{ duration }}s;"
>
  <hero-slideshow
    class="hero-slideshow__inner"
    data-autoplay="{{ section.settings.autoplay }}"
    data-header-overlay="{{ section.settings.header_overlay }}"
  >
    <div class="hero-slideshow__slides" id="HeroSlides-{{ section.id }}" aria-live="polite" data-slides>
      {%- for block in section.blocks -%}
        {%- liquid
          assign role = block.settings.role
          assign eyebrow = block.settings.eyebrow
          assign heading = block.settings.heading
          assign text = block.settings.text
          assign label_1 = block.settings.button_label_1
          assign label_2 = block.settings.button_label_2

          # Blank settings fall back to localized copy for the slide's role (EN/AR).
          case role
            when 'welcome'
              if eyebrow == blank
                assign eyebrow = 'sections.hero.eyebrow_default' | t
              endif
              if heading == blank
                assign heading = 'sections.hero.blocks.heading.settings.heading.default' | t
              endif
              if text == blank
                assign text = 'sections.hero.blocks.text.settings.text.default' | t
              endif
              if label_1 == blank
                assign label_1 = 'sections.hero_slideshow.welcome.button_1' | t
              endif
              if label_2 == blank
                assign label_2 = 'sections.hero_slideshow.welcome.button_2' | t
              endif
            when 'learn' or 'patterns'
              assign key = 'sections.hero_slideshow.' | append: role
              if eyebrow == blank
                assign eyebrow = key | append: '.eyebrow' | t
              endif
              if heading == blank
                assign heading = key | append: '.heading' | t
              endif
              if text == blank
                assign text = key | append: '.text' | t
              endif
              if label_1 == blank
                assign label_1 = key | append: '.button_1' | t
              endif
          endcase

          assign image = block.settings.image
          assign mobile_image = block.settings.mobile_image | default: image
          assign image_alt = block.settings.image_alt | default: image.alt | default: ''

          # Overlay floor: 30% (see docs/DECISIONS.md, M2.1) so ivory text keeps AA on any photo.
          assign overlay = block.settings.overlay | at_least: 30
        -%}
        <div
          class="hero-slide hero-slide--{{ block.settings.content_position }}{% if forloop.first %} is-active{% endif %}{% if image == blank %} hero-slide--no-image{% endif %}"
          role="group"
          aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
          aria-label="{{ 'sections.hero_slideshow.slide_label' | t: index: forloop.index, count: slide_count }}"
          data-slide
          {% unless forloop.first %}
            inert
          {% endunless %}
          style="--hero-overlay: {{ overlay | divided_by: 100.0 }};"
          {{ block.shopify_attributes }}
        >
          <div class="hero-slide__media">
            {%- if image != blank -%}
              {%- liquid
                # Respect the merchant's focal point (Shopify admin) when the image is cropped.
                assign image_style = 'object-position: ' | append: image.presentation.focal_point | append: ';'
                if forloop.first
                  assign loading = 'eager'
                  assign priority = 'high'
                else
                  assign loading = 'lazy'
                  assign priority = 'auto'
                endif
              -%}
              <picture>
                {%- if block.settings.mobile_image != blank -%}
                  <source
                    media="(max-width: 749px)"
                    srcset="{{ mobile_image | image_url: width: 550 }} 550w, {{ mobile_image | image_url: width: 750 }} 750w, {{ mobile_image | image_url: width: 1100 }} 1100w"
                    sizes="100vw"
                  >
                {%- endif -%}
                {{
                  image
                  | image_url: width: 3200
                  | image_tag:
                    class: 'hero-slide__image',
                    loading: loading,
                    fetchpriority: priority,
                    widths: '550, 750, 1100, 1500, 1920, 2400, 3200',
                    sizes: '100vw',
                    alt: image_alt,
                    style: image_style
                }}
              </picture>
            {%- endif -%}
          </div>

          <div class="hero-slide__content-wrap page-width">
            <div class="hero-slide__content">
              {%- if eyebrow != blank -%}
                <p class="th-eyebrow hero-slide__eyebrow">{{ eyebrow | escape }}</p>
              {%- endif -%}
              {%- comment -%}
                One real heading per page for the hero (header has the h1): only slide 1 is an h2.
              {%- endcomment -%}
              {%- if forloop.first -%}
                <h2 class="hero-slide__heading">{{ heading | escape }}</h2>
              {%- else -%}
                <p class="hero-slide__heading">{{ heading | escape }}</p>
              {%- endif -%}
              {%- if text != blank -%}
                <p class="hero-slide__text">{{ text | escape }}</p>
              {%- endif -%}
              {%- liquid
                assign show_1 = false
                if label_1 != blank and block.settings.button_link_1 != blank
                  assign show_1 = true
                endif
                assign show_2 = false
                if label_2 != blank and block.settings.button_link_2 != blank
                  assign show_2 = true
                endif
              -%}
              {%- if show_1 or show_2 -%}
                <div class="hero-slide__buttons">
                  {%- if show_1 -%}
                    <a href="{{ block.settings.button_link_1 }}" class="button hero-slide__button hero-slide__button--primary">
                      {{- label_1 | escape -}}
                    </a>
                  {%- endif -%}
                  {%- if show_2 -%}
                    <a href="{{ block.settings.button_link_2 }}" class="button button--secondary hero-slide__button hero-slide__button--secondary">
                      {{- label_2 | escape -}}
                    </a>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if slide_count > 1 -%}
      <div class="hero-slideshow__controls-wrap page-width">
        <div class="hero-slideshow__controls" role="group" aria-label="{{ 'sections.hero_slideshow.controls' | t }}" data-controls>
          <button
            type="button"
            class="hero-slideshow__toggle"
            aria-label="{{ 'sections.slideshow.pause_slideshow' | t }}"
            aria-pressed="false"
            aria-controls="HeroSlides-{{ section.id }}"
            data-toggle
          >
            <span class="svg-wrapper hero-slideshow__icon-pause">{{- 'icon-pause.svg' | inline_asset_content -}}</span>
            <span class="svg-wrapper hero-slideshow__icon-play">{{- 'icon-play.svg' | inline_asset_content -}}</span>
          </button>
          <div class="hero-progress{% unless section.settings.show_progress %} hero-progress--minimal{% endunless %}">
            {%- for block in section.blocks -%}
              <button
                type="button"
                class="hero-progress__step{% if forloop.first %} is-active{% endif %}"
                aria-label="{{ 'sections.hero_slideshow.show_slide' | t: index: forloop.index, count: slide_count }}"
                aria-controls="HeroSlides-{{ section.id }}"
                {% if forloop.first %}
                  aria-current="true"
                {% endif %}
                data-step
              >
                <span class="hero-progress__track" aria-hidden="true"><span class="hero-progress__fill"></span></span>
              </button>
            {%- endfor -%}
          </div>
          {%- comment -%}Single timer: its CSS animation ending advances the slide.{%- endcomment -%}
          <span class="hero-slideshow__timer" aria-hidden="true" data-timer></span>
        </div>
      </div>
    {%- endif -%}
  </hero-slideshow>
</div>

{% schema %}
{
  "name": "t:sections.hero-slideshow.name",
  "tag": "section",
  "class": "section section-hero-slideshow",
  "max_blocks": 5,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "height",
      "options": [
        { "value": "medium", "label": "t:sections.hero-slideshow.settings.height.options__1.label" },
        { "value": "large", "label": "t:sections.hero-slideshow.settings.height.options__2.label" },
        { "value": "full", "label": "t:sections.hero-slideshow.settings.height.options__3.label" }
      ],
      "default": "large",
      "label": "t:sections.hero-slideshow.settings.height.label"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "default": true,
      "label": "t:sections.hero-slideshow.settings.autoplay.label",
      "info": "t:sections.hero-slideshow.settings.autoplay.info"
    },
    {
      "type": "range",
      "id": "duration",
      "min": 4,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 6,
      "label": "t:sections.hero-slideshow.settings.duration.label"
    },
    {
      "type": "checkbox",
      "id": "show_progress",
      "default": true,
      "label": "t:sections.hero-slideshow.settings.show_progress.label"
    },
    {
      "type": "checkbox",
      "id": "header_overlay",
      "default": true,
      "label": "t:sections.hero-slideshow.settings.header_overlay.label",
      "info": "t:sections.hero-slideshow.settings.header_overlay.info"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-3",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.hero-slideshow.settings.color_scheme.info"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "t:sections.hero-slideshow.blocks.slide.name",
      "settings": [
        {
          "type": "select",
          "id": "role",
          "options": [
            { "value": "welcome", "label": "t:sections.hero-slideshow.blocks.slide.settings.role.options__1.label" },
            { "value": "learn", "label": "t:sections.hero-slideshow.blocks.slide.settings.role.options__2.label" },
            { "value": "patterns", "label": "t:sections.hero-slideshow.blocks.slide.settings.role.options__3.label" },
            { "value": "custom", "label": "t:sections.hero-slideshow.blocks.slide.settings.role.options__4.label" }
          ],
          "default": "custom",
          "label": "t:sections.hero-slideshow.blocks.slide.settings.role.label",
          "info": "t:sections.hero-slideshow.blocks.slide.settings.role.info"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.hero-slideshow.blocks.slide.settings.image.label",
          "info": "t:sections.hero-slideshow.blocks.slide.settings.image.info"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "t:sections.hero-slideshow.blocks.slide.settings.mobile_image.label",
          "info": "t:sections.hero-slideshow.blocks.slide.settings.mobile_image.info"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "t:sections.hero-slideshow.blocks.slide.settings.image_alt.label",
          "info": "t:sections.hero-slideshow.blocks.slide.settings.image_alt.info"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "t:sections.editorial.settings.eyebrow.label",
          "info": "t:sections.editorial.settings.default_copy.info"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.editorial.settings.heading.label",
          "info": "t:sections.editorial.settings.default_copy.info"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.editorial.settings.text.label",
          "info": "t:sections.editorial.settings.default_copy.info"
        },
        {
          "type": "text",
          "id": "button_label_1",
          "label": "t:sections.hero-slideshow.blocks.slide.settings.button_label_1.label",
          "info": "t:sections.editorial.settings.default_copy.info"
        },
        {
          "type": "url",
          "id": "button_link_1",
          "label": "t:sections.hero-slideshow.blocks.slide.settings.button_link_1.label"
        },
        {
          "type": "text",
          "id": "button_label_2",
          "label": "t:sections.hero-slideshow.blocks.slide.settings.button_label_2.label",
          "info": "t:sections.editorial.settings.default_copy.info"
        },
        {
          "type": "url",
          "id": "button_link_2",
          "label": "t:sections.hero-slideshow.blocks.slide.settings.button_link_2.label"
        },
        {
          "type": "select",
          "id": "content_position",
          "options": [
            { "value": "start", "label": "t:sections.hero-slideshow.blocks.slide.settings.content_position.options__1.label" },
            { "value": "center", "label": "t:sections.hero-slideshow.blocks.slide.settings.content_position.options__2.label" },
            { "value": "end", "label": "t:sections.hero-slideshow.blocks.slide.settings.content_position.options__3.label" }
          ],
          "default": "start",
          "label": "t:sections.hero-slideshow.blocks.slide.settings.content_position.label"
        },
        {
          "type": "range",
          "id": "overlay",
          "min": 0,
          "max": 80,
          "step": 5,
          "unit": "%",
          "default": 40,
          "label": "t:sections.hero-slideshow.blocks.slide.settings.overlay.label",
          "info": "t:sections.hero-slideshow.blocks.slide.settings.overlay.info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.hero-slideshow.presets.name",
      "blocks": [
        { "type": "slide", "settings": { "role": "welcome" } },
        { "type": "slide", "settings": { "role": "learn" } },
        { "type": "slide", "settings": { "role": "patterns" } }
      ]
    }
  ]
}
{% endschema %}
